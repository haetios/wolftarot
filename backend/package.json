{
  "private": true,
  "name": "backend",
  "version": "0.1.0",
  "description": "A Colyseus multiplayer server",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">= 22.0.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "loadtest": "tsx loadtest/example.ts --room tarot --numClients 4",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@colyseus/loadtest": "^0.18.1",
    "@colyseus/sdk": "^0.18.1",
    "@colyseus/testing": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.14",
    "@colyseus/tools": "^0.18.1",
    "colyseus": "^0.18.2",
    "express": "^5.2.1"
  }
}
